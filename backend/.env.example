# Local PostgreSQL started by `make db-up`.
DATABASE_URL=postgresql+psycopg://tasteiq:tasteiq@localhost:5432/tasteiq

# Optional retrieval experiment. The default is the measured BM25 champion.
RETRIEVAL_MODE=bm25

# Optional grounded generation. Without a key, chat uses the deterministic local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
